{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlarrick.github.io/hvac-profiles/schema/v1/producer.schema.json",
  "title": "HVAC Producer Profile (v1)",
  "description": "Schema for generalized HVAC producer equipment profiles consumed by hvac-crossover and hvac-fusion.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "make",
        "model",
        "producer_type",
        "heating_performance"
      ],
      "properties": {
        "make": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "series": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producer_type": {
          "const": "inverter_heat_pump"
        },
        "min_operational_temp_f": {
          "type": "number",
          "minimum": -60,
          "maximum": 70
        },
        "heating_performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_load_cop",
            "capacity_percentage"
          ],
          "properties": {
            "full_load_cop": {
              "$ref": "#/$defs/copCurve"
            },
            "part_load_cop": {
              "$ref": "#/$defs/copCurve"
            },
            "capacity_percentage": {
              "$ref": "#/$defs/capacityPctCurve"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "make",
        "model",
        "producer_type",
        "rated_afue"
      ],
      "properties": {
        "make": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "series": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producer_type": {
          "const": "modulating_boiler"
        },
        "fuel_type": {
          "$ref": "#/$defs/fuelType"
        },
        "rated_afue": {
          "$ref": "#/$defs/afue"
        },
        "turndown_ratio": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 30.0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "make",
        "model",
        "producer_type",
        "rated_afue"
      ],
      "properties": {
        "make": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "series": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producer_type": {
          "const": "atmospheric_boiler"
        },
        "fuel_type": {
          "$ref": "#/$defs/fuelType"
        },
        "rated_afue": {
          "$ref": "#/$defs/afue"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "make",
        "model",
        "producer_type",
        "rated_afue"
      ],
      "properties": {
        "make": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "series": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producer_type": {
          "const": "steam_boiler"
        },
        "fuel_type": {
          "$ref": "#/$defs/fuelType"
        },
        "rated_afue": {
          "$ref": "#/$defs/afue"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "make",
        "model",
        "producer_type",
        "rated_afue"
      ],
      "properties": {
        "make": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "series": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producer_type": {
          "const": "furnace"
        },
        "fuel_type": {
          "$ref": "#/$defs/fuelType"
        },
        "rated_afue": {
          "$ref": "#/$defs/afue"
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "fuelType": {
      "type": "string",
      "enum": [
        "natural_gas",
        "propane",
        "oil"
      ]
    },
    "afue": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 1.0
    },
    "copCurve": {
      "type": "object",
      "minProperties": 2,
      "patternProperties": {
        "^-?[0-9]+(\\.[0-9]+)?$": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 10.0
        }
      },
      "additionalProperties": false
    },
    "capacityPctCurve": {
      "type": "object",
      "minProperties": 2,
      "patternProperties": {
        "^-?[0-9]+(\\.[0-9]+)?$": {
          "type": "number",
          "minimum": 5.0,
          "maximum": 150.0
        }
      },
      "additionalProperties": false
    }
  }
}
